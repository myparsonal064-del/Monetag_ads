<div id="toast" class="toast"></div>


<script>
/*
  DEMO LOGIN ONLY

  IMPORTANT:
  Credentials inside client-side HTML/JS are NOT secret.
  For production, move authentication to a backend.
*/

const ADMIN_USERNAME = "Admin Sheikh";
const ADMIN_PASSWORD = "Salman.Sheikh.@1";

const loginPage = document.getElementById("loginPage");
const app = document.getElementById("app");
const loginForm = document.getElementById("loginForm");
const loginError = document.getElementById("loginError");
const loginButton = document.getElementById("loginButton");

let failedAttempts = 0;
let lockedUntil = 0;

loginForm.addEventListener("submit", function(e){

  e.preventDefault();

  const now = Date.now();

  if(now < lockedUntil){
    const seconds = Math.ceil((lockedUntil-now)/1000);
    loginError.style.display = "block";
    loginError.textContent =
      "Too many failed attempts. Try again in " + seconds + " seconds.";
    return;
  }

  const username =
    document.getElementById("username").value.trim();

  const password =
    document.getElementById("password").value;

  loginButton.disabled = true;
  loginButton.textContent = "Logging in...";

  setTimeout(() => {

    if(
      username === ADMIN_USERNAME &&
      password === ADMIN_PASSWORD
    ){

      failedAttempts = 0;

      loginPage.style.display = "none";
      app.style.display = "block";

      loginError.style.display = "none";

    }else{

      failedAttempts++;

      loginError.style.display = "block";
      loginError.textContent =
        "Invalid username or password.";

      if(failedAttempts >= 5){

        lockedUntil = Date.now() + 30000;
        failedAttempts = 0;

        loginError.textContent =
          "Too many failed attempts. Login temporarily rate-limited.";
      }

    }

    loginButton.disabled = false;
    loginButton.textContent = "Login";

  },700);

});


function togglePassword(){

  const password =
    document.getElementById("password");

  password.type =
    password.type === "password"
      ? "text"
      : "password";
}


function toggleSidebar(){

  document
    .getElementById("sidebar")
    .classList.toggle("open");
}


function showPage(pageId, element){

  document.querySelectorAll(".page")
    .forEach(page => page.classList.remove("active"));

  const page =
    document.getElementById(pageId);

  if(page){
    page.classList.add("active");
  }

  document.querySelectorAll(".nav-item")
    .forEach(item => item.classList.remove("active"));

  if(element){
    element.classList.add("active");
  }

  const titles = {
    dashboard:"Dashboard",
    users:"Users",
    tasks:"Manage Tasks",
    createTask:"Add Task",
    ads:"Advertisements",
    createAd:"Add Advertisement",
    withdrawals:"Withdrawals",
    transactions:"Wallet Transactions",
    telegramBot:"Telegram Bot Settings",
    miniApp:"Telegram Mini App",
    telegramStatus:"Telegram Configuration Status",
    withdrawalSettings:"Withdrawal Settings",
    generalSettings:"General Settings",
    account:"Admin Account",
    audit:"Audit Logs"
  };

  document.getElementById("pageTitle").textContent =
    titles[pageId] || "Admin Panel";

  document
    .getElementById("sidebar")
    .classList.remove("open");

}


function logout(){

  if(confirm("Are you sure you want to logout?")){

    app.style.display = "none";
    loginPage.style.display = "flex";

    document.getElementById("username").value = "";
    document.getElementById("password").value = "";

    showPage("dashboard");

    toast("Logged out successfully");
  }

}


function approveWithdrawal(){

  const ok =
    confirm(
      "Are you sure you want to approve this withdrawal?"
    );

  if(ok){
    toast("Withdrawal approval request submitted");
  }

}


function toast(message){

  const el =
    document.getElementById("toast");

  el.textContent = message;
  el.style.display = "block";

  setTimeout(()=>{
    el.style.display = "none";
  },2500);

}
</script>

